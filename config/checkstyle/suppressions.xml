<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress all checks for test sources -->
    <suppress files="[\\/]test[\\/]" checks=".*"/>
    <suppress files="[\\/]integrationTest[\\/]" checks=".*"/>

    <!-- Suppress HideUtilityClassConstructor for Spring Boot main classes -->
    <suppress files="AtlasOpsApplication\.java" checks="HideUtilityClassConstructor"/>
    <suppress files="WorkerApplication\.java" checks="HideUtilityClassConstructor"/>

    <!-- Suppress package-info.java file length (they are short) -->
    <suppress files="package-info\.java" checks="FileLength"/>
</suppressions>
