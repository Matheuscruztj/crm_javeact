# AtlasOps AI - Local Environment Variables
# Copy from infra/.env.example for reference values

# Application
APP_ENV=local
APP_PORT=8080

# Database
POSTGRES_PORT=5432
POSTGRES_USER=atlasops
POSTGRES_PASSWORD=atlasops_local
POSTGRES_DB=atlasops
DATABASE_URL=jdbc:postgresql://localhost:5432/atlasops

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=atlasops-local

# AI (Ollama)
OLLAMA_PORT=11434
AI_BASE_URL=http://localhost:11434

# Monitoring
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Mail
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025

# Security
JWT_ISSUER=atlasops-local
JWT_AUDIENCE=atlasops-api
JWT_SECRET=local-dev-secret-min-32-chars-long

# Logging
LOG_LEVEL=INFO
